+#ifndef _OgreMetalWindowNull_H_
+#define _OgreMetalWindowNull_H_
+
+#include "OgreMetalPrerequisites.h"
+
+#include "OgreWindow.h"
+
+namespace Ogre
+{
+    /** A Window that owns no NSWindow, no OgreMetalView and no CAMetalLayer.
+
+        Selected with miscParams["windowType"] = "null". It exists purely so that
+        MetalRenderSystem can complete its one time initialisation (device, capabilities,
+        VaoManager, TextureGpuManager) and so that Root creates the CompositorManager2,
+        both of which only happen inside _createRenderWindow. None of that work touches a
+        window, so on a machine with no WindowServer session this is enough to bring a real
+        Metal render system up headlessly.
+
+        Its texture is a plain MetalTextureGpuRenderTarget, deliberately *not* flagged
+        RenderWindowSpecific, so MetalRenderPassDescriptor::performLoadActions never tries
+        to acquire a CAMetalDrawable for it. Rendering is expected to target the caller's
+        own textures rather than this one.
+
+        Mirrors VulkanWindowNull.
+    */
+    class _OgreMetalExport MetalWindowNull final : public Window
+    {
+        bool         mClosed;
+        bool         mHwGamma;
+        MetalDevice *mDevice;
+
+    public:
+        MetalWindowNull( const String &title, uint32 width, uint32 height, bool fullscreenMode,
+                         const NameValuePairList *miscParams, MetalDevice *ownerDevice );
+        ~MetalWindowNull() override;
+
+        void destroy() override;
+
+        void _initialize( TextureGpuManager *textureGpuManager ) override;
+
+        void reposition( int32 leftPt, int32 topPt ) override;
+        void requestResolution( uint32 widthPt, uint32 heightPt ) override;
+
+        bool isClosed() const override;
+        void _setVisible( bool visible ) override;
+        bool isVisible() const override;
+        void setHidden( bool hidden ) override;
+        bool isHidden() const override;
+
+        void swapBuffers() override;
+
+        void getCustomAttribute( IdString name, void *pData ) override;
+    };
+}  // namespace Ogre
+
+#endif
