+
+#include "OgreMetalWindowNull.h"
+
+#include "OgreDepthBuffer.h"
+#include "OgreMetalDevice.h"
+#include "OgreMetalTextureGpu.h"
+#include "OgreMetalTextureGpuManager.h"
+#include "OgreRenderSystem.h"
+#include "OgreStringConverter.h"
+
+namespace Ogre
+{
+    MetalWindowNull::MetalWindowNull( const String &title, uint32 width, uint32 height,
+                                      bool fullscreenMode, const NameValuePairList *miscParams,
+                                      MetalDevice *ownerDevice ) :
+        Window( title, width, height, fullscreenMode ),
+        mClosed( false ),
+        mHwGamma( true ),
+        mDevice( ownerDevice )
+    {
+        if( miscParams )
+        {
+            NameValuePairList::const_iterator opt;
+            NameValuePairList::const_iterator endt = miscParams->end();
+
+            opt = miscParams->find( "FSAA" );
+            if( opt != endt )
+                mRequestedSampleDescription.parseString( opt->second );
+
+            opt = miscParams->find( "gamma" );
+            if( opt != endt )
+                mHwGamma = StringConverter::parseBool( opt->second );
+        }
+    }
+    //-------------------------------------------------------------------------
+    MetalWindowNull::~MetalWindowNull() { destroy(); }
+    //-------------------------------------------------------------------------
+    void MetalWindowNull::destroy()
+    {
+        mClosed = true;
+
+        // The base Window does not own these.
+        if( mTexture )
+        {
+            mTexture->notifyAllListenersTextureChanged( TextureGpuListener::Deleted );
+            OGRE_DELETE mTexture;
+            mTexture = 0;
+        }
+        mDepthBuffer = 0;
+        mStencilBuffer = 0;
+    }
+    //-------------------------------------------------------------------------
+    void MetalWindowNull::_initialize( TextureGpuManager *textureGpuManager )
+    {
+        MetalTextureGpuManager *textureManager =
+            static_cast<MetalTextureGpuManager *>( textureGpuManager );
+
+        setFinalResolution( mRequestedWidth, mRequestedHeight );
+
+        // A plain MetalTextureGpuRenderTarget rather than a MetalTextureGpuWindow, since
+        // there is no CAMetalDrawable to hand out.
+        //
+        // RenderWindowSpecific is required even so: RenderSystem::shutdown() calls
+        // _resetTextureManager() on every window's texture before deleting the window, and
+        // MetalTextureGpu::_setToDisplayDummyTexture() asserts that a texture with no manager
+        // is window specific. MetalTextureGpuManager::createWindowDepthBuffer() flags a plain
+        // render target the same way for the same reason.
+        //
+        // The flag also makes MetalRenderPassDescriptor::performLoadActions static_cast a
+        // colour attachment to MetalTextureGpuWindow to acquire a drawable, which would be
+        // wrong here. That path is unreachable because this texture is never attached to a
+        // workspace: a null window exists only to bootstrap the render system, and callers
+        // are expected to render into their own textures.
+        mTexture = OGRE_NEW MetalTextureGpuRenderTarget(
+            GpuPageOutStrategy::Discard, textureManager->getVaoManager(), "RenderWindow",
+            TextureFlags::NotTexture | TextureFlags::RenderToTexture |
+                TextureFlags::RenderWindowSpecific | TextureFlags::DiscardableContent,
+            TextureTypes::Type2D, textureManager );
+
+        // No window depth buffer. MetalTextureGpuManager::createWindowDepthBuffer() tags its
+        // texture RenderWindowSpecific, and RenderSystem::getDepthBufferFor only consults
+        // window->getDepthBuffer() when the colour texture is window specific, which ours is
+        // not. Allocating one would be dead memory.
+        mDepthBuffer = 0;
+        mStencilBuffer = 0;
+
+        setFinalResolution( mRequestedWidth, mRequestedHeight );
+
+        mTexture->setPixelFormat( mHwGamma ? PFG_BGRA8_UNORM_SRGB : PFG_BGRA8_UNORM );
+        mTexture->_setDepthBufferDefaults( DepthBuffer::POOL_DEFAULT, false,
+                                           DepthBuffer::DefaultDepthBufferFormat );
+
+        mSampleDescription = textureManager->getRenderSystem()->validateSampleDescription(
+            mRequestedSampleDescription, mTexture->getPixelFormat() );
+        mTexture->_setSampleDescription( mRequestedSampleDescription, mSampleDescription );
+
+        mTexture->_transitionTo( GpuResidency::Resident, (uint8 *)0 );
+    }
+    //-------------------------------------------------------------------------
+    void MetalWindowNull::reposition( int32 leftPt, int32 topPt ) {}
+    //-------------------------------------------------------------------------
+    void MetalWindowNull::requestResolution( uint32 widthPt, uint32 heightPt )
+    {
+        Window::requestResolution( widthPt, heightPt );
+
+        if( mTexture && mTexture->getResidencyStatus() != GpuResidency::OnStorage )
+            setFinalResolution( widthPt, heightPt );
+    }
+    //-------------------------------------------------------------------------
+    bool MetalWindowNull::isClosed() const { return mClosed; }
+    //-------------------------------------------------------------------------
+    void MetalWindowNull::_setVisible( bool visible ) {}
+    //-------------------------------------------------------------------------
+    bool MetalWindowNull::isVisible() const { return false; }
+    //-------------------------------------------------------------------------
+    void MetalWindowNull::setHidden( bool hidden ) {}
+    //-------------------------------------------------------------------------
+    bool MetalWindowNull::isHidden() const { return true; }
+    //-------------------------------------------------------------------------
+    void MetalWindowNull::swapBuffers() {}
+    //-------------------------------------------------------------------------
+    void MetalWindowNull::getCustomAttribute( IdString name, void *pData )
+    {
+        if( name == "MetalDevice" )
+        {
+            *static_cast<MetalDevice **>( pData ) = mDevice;
+        }
+        else
+        {
+            Window::getCustomAttribute( name, pData );
+        }
+    }
+}  // namespace Ogre
