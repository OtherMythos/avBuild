+    //-----------------------------------------------------------------------
+    Item *SceneManager::createItem( const MeshPtr &pMesh, SceneMemoryMgrTypes sceneType,
+                                    HlmsDatablock *datablock )
+    {
+        ItemFactory *factory = static_cast<ItemFactory *>(
+            Root::getSingleton().getMovableObjectFactory( ItemFactory::FACTORY_TYPE_NAME ) );
+        MovableObjectCollection *objectMap =
+            getMovableObjectCollection( ItemFactory::FACTORY_TYPE_NAME );
+
+        OGRE_LOCK_MUTEX( objectMap->mutex );
+
+        Item *item = factory->createItem( Id::generateNewId<MovableObject>(),
+                                          &mEntityMemoryManager[sceneType], this, pMesh, datablock );
+        objectMap->movableObjects.push_back( item );
+        item->mGlobalIndex = objectMap->movableObjects.size() - 1;
+        return item;
+    }
     //-----------------------------------------------------------------------
     void SceneManager::destroyItem( Item *i ) { destroyMovableObject( i ); }
     //-----------------------------------------------------------------------
